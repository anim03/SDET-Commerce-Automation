{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "orderId",
    "totalAmount",
    "status",
    "createdAt",
    "items"
  ],
  "properties": {
    "orderId": {
      "type": "integer"
    },
    "totalAmount": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "CREATED",
        "CANCELLED"
      ]
    },
    "createdAt": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "productId",
          "productName",
          "price",
          "quantity",
          "subtotal"
        ],
        "properties": {
          "productId": {
            "type": "integer"
          },
          "productName": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "subtotal": {
            "type": "number"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}